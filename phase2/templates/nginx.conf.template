# Root master drops workers to a distinct identity for two-Mac pf isolation.
user {{EDGE_USER}};
worker_processes 1;
pid {{NGINX_PID}};
error_log {{ERROR_LOG}} info;
events { worker_connections 256; }
http {
    default_type application/json;
    log_format course '$time_iso8601 client=$remote_addr:$remote_port request="$request" '
        'status=$status tls=$ssl_protocol upstream=$upstream_addr '
        'upstream_status=$upstream_status backend=$upstream_http_x_backend elapsed=$request_time';
    access_log {{ACCESS_LOG}} course;
    client_body_temp_path {{CLIENT_TEMP}};
    proxy_temp_path {{PROXY_TEMP}};
    upstream course_backends {
        server {{BACKEND_A_IP}}:{{BACKEND_A_PORT}} max_fails=1 fail_timeout={{FAIL_TIMEOUT}}s;
        server {{BACKEND_B_IP}}:{{BACKEND_B_PORT}} max_fails=1 fail_timeout={{FAIL_TIMEOUT}}s;
    }
    server {
        listen {{EDGE_LISTEN}}:{{HTTP_PORT}};
        server_name {{APP_DOMAIN}} {{API_DOMAIN}};
        return 308 https://$host:{{HTTPS_PORT}}$request_uri;
    }
    server {
        listen {{EDGE_LISTEN}}:{{HTTPS_PORT}} ssl;
        server_name {{APP_DOMAIN}} {{API_DOMAIN}};
        ssl_certificate {{SERVER_CERT}};
        ssl_certificate_key {{SERVER_KEY}};
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header X-Edge "{{EDGE_LABEL}}" always;
        location / {
            proxy_pass http://course_backends;
            proxy_bind {{EDGE_LISTEN}};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Port {{HTTPS_PORT}};
            proxy_connect_timeout 2s;
            proxy_read_timeout 5s;
            proxy_send_timeout 5s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries 2;
            proxy_next_upstream_timeout 8s;
            proxy_intercept_errors on;
        }
        error_page 502 503 504 =502 /__upstream_unavailable;
        location = /__upstream_unavailable {
            internal;
            add_header X-Edge "{{EDGE_LABEL}}" always;
            add_header Cache-Control "no-store" always;
            return 502 '{"error":"both backend upstreams unavailable"}\n';
        }
    }
}
