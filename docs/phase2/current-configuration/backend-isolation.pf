# Both Macs must apply this anchor. Only dedicated nginx workers open backend sockets.
# The root dispatcher must already include anchor "com.apple/*"; no root rules are replaced.
table <cn_edges> const { 10.7.12.26, 10.7.7.242 }
table <cn_backends> const { 10.7.12.26, 10.7.7.242 }
pass out quick inet proto tcp from any to <cn_backends> port { 3001, 3002 } user 70 flags S/SA keep state
block return out quick inet proto tcp from any to <cn_backends> port { 3001, 3002 }
pass in quick inet proto tcp from <cn_edges> to <cn_backends> port { 3001, 3002 } flags S/SA keep state
block return in quick inet proto tcp from any to <cn_backends> port { 3001, 3002 }
